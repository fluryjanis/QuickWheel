{
  "manifest_version": 3,
  "name": "Quick Wheel",
  "version": "1.1.0",
  "description": "Triggered by middle-click hold or Alt+Q for instant tab, search, and context actions.",
  "permissions": [
    "tabs",
    "sessions",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-quick-wheel": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Activate Quick Wheel radial menu"
    }
  },
  "icons": {
    "48": "icon48.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}